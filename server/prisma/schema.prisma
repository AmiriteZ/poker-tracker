generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  ORGANISER
  MEMBER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

/// When a player's hole cards flip face-up during a highlight's playback animation.
enum RevealStage {
  START
  FLOP
  TURN
  RIVER
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  groupsCreated   Group[]         @relation("GroupCreator")
  sessionsCreated Session[]       @relation("SessionCreator")
  results         SessionResult[]
  soloGames       SoloGame[]
  chipsSold       ChipTransfer[] @relation("ChipSeller")
  chipsBought     ChipTransfer[] @relation("ChipBuyer")
  highlightsCreated    Highlight[]        @relation("HighlightCreatedBy")
  highlightAppearances HighlightPlayer[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String   @unique
  currency    String   @default("€")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User         @relation("GroupCreator", fields: [createdById], references: [id])
  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  groupId   String
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Session {
  id          String   @id @default(cuid())
  groupId     String
  title       String?
  location    String?
  notes       String?
  playedAt    DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SessionCreator", fields: [createdById], references: [id])
  results    SessionResult[]
  transfers  ChipTransfer[]
  highlights Highlight[]

  @@index([groupId, playedAt])
}

/// One row per player per session. Admin adds the player (buyIn 0, cashOut null);
/// the player then submits their own buy-in and cash-out.
/// buyIn / cashOut are the bank figures. chipsBought / chipsSold are denormalised
/// sums of ChipTransfer rows (kept in sync by the API) so that
///   effective buy-in  = buyIn + chipsBought
///   effective cash-out = cashOut + chipsSold
///   net = effective cash-out - effective buy-in
model SessionResult {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  buyIn       Decimal  @default(0) @db.Decimal(12, 2)
  cashOut     Decimal? @db.Decimal(12, 2)
  chipsBought Decimal  @default(0) @db.Decimal(12, 2)
  chipsSold   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

/// A player buying chips from another player mid-game (not from the bank).
/// The pot is unchanged; the buyer's buy-in and the seller's cash-out both rise by `amount`.
model ChipTransfer {
  id          String   @id @default(cuid())
  sessionId   String
  fromUserId  String   // seller
  toUserId    String   // buyer
  amount      Decimal  @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  from    User    @relation("ChipSeller", fields: [fromUserId], references: [id], onDelete: Cascade)
  to      User    @relation("ChipBuyer", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// A curated replay of one hand played during a game day: the 5 community cards
/// (positions 0-2 flop, 3 turn, 4 river) plus which players were involved and when
/// their hole cards flip face-up during the playback animation.
model Highlight {
  id          String   @id @default(cuid())
  sessionId   String
  title       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session   Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User              @relation("HighlightCreatedBy", fields: [createdById], references: [id])
  cards     HighlightCard[]
  players   HighlightPlayer[]

  @@index([sessionId])
}

/// One of the 5 fixed community-card slots on a highlight (0-2 flop, 3 turn, 4 river).
model HighlightCard {
  id          String    @id @default(cuid())
  highlightId String
  position    Int
  rank        String // "2".."10" | "J" | "Q" | "K" | "A"
  suit        String // "club" | "diamond" | "heart" | "spade"

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@unique([highlightId, position])
}

/// A player featured in a highlight, with their hole cards (filled in after they're
/// added) and the stage at which their cards flip face-up in the playback animation.
model HighlightPlayer {
  id          String      @id @default(cuid())
  highlightId String
  userId      String
  revealedAt  RevealStage @default(START)
  holeRank1   String?
  holeSuit1   String?
  holeRank2   String?
  holeSuit2   String?
  seatOrder   Int         @default(0)

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([highlightId, userId])
}

/// Games played outside any group (home games with strangers, casino, online...).
model SoloGame {
  id        String   @id @default(cuid())
  userId    String
  playedAt  DateTime
  location  String?
  notes     String?
  buyIn     Decimal  @db.Decimal(12, 2)
  cashOut   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}
