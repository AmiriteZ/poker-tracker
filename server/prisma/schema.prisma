generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  ORGANISER
  MEMBER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  groupsCreated   Group[]         @relation("GroupCreator")
  sessionsCreated Session[]       @relation("SessionCreator")
  results         SessionResult[]
  soloGames       SoloGame[]
  chipsSold       ChipTransfer[] @relation("ChipSeller")
  chipsBought     ChipTransfer[] @relation("ChipBuyer")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String   @unique
  currency    String   @default("€")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User         @relation("GroupCreator", fields: [createdById], references: [id])
  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  groupId   String
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Session {
  id          String   @id @default(cuid())
  groupId     String
  title       String?
  location    String?
  notes       String?
  playedAt    DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SessionCreator", fields: [createdById], references: [id])
  results   SessionResult[]
  transfers ChipTransfer[]

  @@index([groupId, playedAt])
}

/// One row per player per session. Admin adds the player (buyIn 0, cashOut null);
/// the player then submits their own buy-in and cash-out.
/// buyIn / cashOut are the bank figures. chipsBought / chipsSold are denormalised
/// sums of ChipTransfer rows (kept in sync by the API) so that
///   effective buy-in  = buyIn + chipsBought
///   effective cash-out = cashOut + chipsSold
///   net = effective cash-out - effective buy-in
model SessionResult {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  buyIn       Decimal  @default(0) @db.Decimal(12, 2)
  cashOut     Decimal? @db.Decimal(12, 2)
  chipsBought Decimal  @default(0) @db.Decimal(12, 2)
  chipsSold   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

/// A player buying chips from another player mid-game (not from the bank).
/// The pot is unchanged; the buyer's buy-in and the seller's cash-out both rise by `amount`.
model ChipTransfer {
  id          String   @id @default(cuid())
  sessionId   String
  fromUserId  String   // seller
  toUserId    String   // buyer
  amount      Decimal  @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  from    User    @relation("ChipSeller", fields: [fromUserId], references: [id], onDelete: Cascade)
  to      User    @relation("ChipBuyer", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Games played outside any group (home games with strangers, casino, online...).
model SoloGame {
  id        String   @id @default(cuid())
  userId    String
  playedAt  DateTime
  location  String?
  notes     String?
  buyIn     Decimal  @db.Decimal(12, 2)
  cashOut   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}
